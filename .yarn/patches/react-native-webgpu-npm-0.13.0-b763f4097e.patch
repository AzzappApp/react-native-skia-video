+std::shared_ptr<GPUExternalTexture>
+GPUExternalTexture::CreateFromSharedTexture(
+    wgpu::Device device, const wgpu::SharedTextureMemory &memory,
+    const wgpu::Texture &texture, double rotation) {
+#if defined(__ANDROID__)
+  if (memory == nullptr || texture == nullptr) {
+    throw std::runtime_error(
+        "GPUDevice::createExternalTexture(): the memory or the texture has "
+        "been destroyed");
+  }
+  // The YUV->RGB conversion the shader applies, as in Create.
+  std::array<float, 12> yuvToRgbMatrix = kYuvPassthroughMatrix;
+  if (texture.GetFormat() == wgpu::TextureFormat::OpaqueYCbCrAndroid) {
+    wgpu::SharedTextureMemoryAHardwareBufferProperties ahbProps{};
+    wgpu::SharedTextureMemoryProperties props{};
+    props.nextInChain = &ahbProps;
+    if (memory.GetProperties(&props) == wgpu::Status::Success) {
+      yuvToRgbMatrix = makeYuvToRgbMatrix(ahbProps.yCbCrInfo.vkYCbCrModel,
+                                          ahbProps.yCbCrInfo.vkYCbCrRange);
+    } else {
+      yuvToRgbMatrix = makeYuvToRgbMatrix(/* YCBCR_601 */ 3,
+                                          /* ITU_NARROW */ 1);
+    }
+  }
+
+  wgpu::ExternalTextureDescriptor extDesc{};
+  extDesc.cropOrigin = {0, 0};
+  extDesc.cropSize = {texture.GetWidth(), texture.GetHeight()};
+  extDesc.apparentSize = {texture.GetWidth(), texture.GetHeight()};
+  extDesc.gamutConversionMatrix = kIdentityGamutMatrix;
+  wgpu::TextureView plane0 = texture.CreateView();
+  extDesc.plane0 = plane0;
+  extDesc.srcTransferFunctionParameters = kIdentityTransferParams;
+  extDesc.dstTransferFunctionParameters = kIdentityTransferParams;
+  extDesc.rotation = toExternalTextureRotation(rotation);
+
+  auto external = device.CreateExternalTexture(&extDesc);
+  if (external == nullptr) {
+    throw std::runtime_error(
+        "GPUDevice::createExternalTexture(): CreateExternalTexture returned "
+        "null");
+  }
+  // No memory nor texture: destroy() leaves them to the caller.
+  return std::make_shared<GPUExternalTexture>(
+      std::move(external), nullptr, nullptr, nullptr, "external-texture",
+      std::move(yuvToRgbMatrix));
+#else
+  throw std::runtime_error(
+      "GPUDevice::createExternalTexture(): only implemented on Android");
+#endif
+}
